{
  "name": "sparkline-mini-charts",
  "version": "1.3.0",
  "description": "Zero-dependency SVG sparkline Web Components with Shadow DOM, responsive scaling, and framework bindings.",
  "author": "Erlon Rru",
  "license": "MIT",
  "homepage": "https://sparkline-mini-chart.erlonrru.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/ErlonRru/sparkline-mini-charts.git"
  },
