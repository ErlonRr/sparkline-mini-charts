{
  "name": "sparkline-mini-charts-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "pnpm workspace of sparkline-mini-charts: the published library (packages/core), the demo (apps/demo) and the repository tools (tools/scripts).",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter sparkline-mini-charts-demo run dev",
    "build": "pnpm --filter sparkline-mini-charts run build",
    "build:demo": "pnpm --filter sparkline-mini-charts-demo run build",
    "preview": "pnpm --filter sparkline-mini-charts-demo run preview",
    "screenshots": "node tools/scripts/screenshots.mjs",
    "test": "pnpm run test:unit",
    "test:unit": "pnpm -r --if-present run test:unit",
    "test:package": "pnpm --filter sparkline-mini-charts run test:package",
    "test:e2e": "pnpm --filter sparkline-mini-charts-demo run test:e2e",
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint:source": "pnpm -r --if-present run lint:source",
    "lint:docs": "pnpm -r --if-present run lint:docs",
    "lint:package": "pnpm --filter sparkline-mini-charts run lint:package",
    "api:check": "pnpm --filter sparkline-mini-charts run api:check",
    "api:update": "pnpm --filter sparkline-mini-charts run api:update",
    "compare-pack": "node tools/scripts/compare-pack.mjs",
    "sync-root-files": "node tools/scripts/sync-root-files.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version && node tools/scripts/release-changelog.mjs && node tools/scripts/sync-root-files.mjs",
    "release": "changeset publish"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.20.0",
  "devDependencies": {
    "@changesets/cli": "3.0.3"
  }
}
