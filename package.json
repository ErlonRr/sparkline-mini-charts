  },
  "scripts": {
    "dev": "vite --config vite.config.demo.js",
    "build": "vite build && node scripts/emit-entry-dts.mjs",
    "build:demo": "vite build --config vite.config.demo.js",
    "preview": "vite preview --config vite.config.demo.js",
    "test": "pnpm run test:unit",
    "test:unit": "node --test \"test/**/!(package-*).test.js\"",
    "test:package": "node --test \"test/package-*.test.js\"",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint:source": "node scripts/check-source.mjs",
    "lint:docs": "node scripts/check-docs.mjs",
    "lint:package": "publint --strict && attw --pack .",
    "api:check": "node scripts/api-report.mjs",
    "api:update": "node scripts/api-report.mjs --update",
    "prepack": "pnpm build 1>&2",
    "prepublishOnly": "pnpm test:unit && pnpm build && pnpm test:package && pnpm api:check",
    "changeset": "changeset",
    "version-packages": "changeset version && node scripts/release-changelog.mjs",
    "release": "changeset publish"
  },
