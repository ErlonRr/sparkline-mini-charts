  "sideEffects": [
    "./dist/register.js",
    "./dist/register.cjs",
    "./dist/react.js",
    "./dist/react.cjs"
  ],
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite --config vite.config.demo.js",
    "build": "vite build",
    "build:demo": "vite build --config vite.config.demo.js",
    "preview": "vite preview --config vite.config.demo.js",
    "test": "node --test",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.20.0",
  "keywords": [
    "sparkline",
    "chart",
    "svg",
    "web-components",
    "custom-elements",
    "shadow-dom",
    "vanilla-javascript",
    "zero-dependency"
  ],
  "devDependencies": {
    "@typescript/typescript6": "^6.0.2",
    "@angular/core": "^22.1.1",
    "@types/react": "^19.2.7",
    "react": "^19.2.8",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vite-plugin-dts": "^5.0.3",
    "vue": "^3.5.41"
  },
  "peerDependencies": {
    "@angular/core": ">=20.0.0",
    "react": ">=18.0.0",
    "vue": ">=3.5.0"
  },
  "peerDependenciesMeta": {
    "@angular/core": {
      "optional": true
    },
    "react": {
